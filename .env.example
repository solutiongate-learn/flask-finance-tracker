# .env.example — Copy this file to .env and fill in your values.
# ================================================================
# NEVER commit .env to version control (it's in .gitignore).
# This example file IS safe to commit — it contains no secrets.
# ================================================================

# Flask secret key — used to sign session cookies.
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Path to the SQLite database file (relative to project root)
DATABASE_PATH=database/app.db

# Set to "false" in production
DEBUG=true

# Port to listen on
PORT=5001
